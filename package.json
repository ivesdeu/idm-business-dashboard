{
  "name": "idm-business-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --host localhost --port 5173 --strictPort",
    "prebuild": "node scripts/generate-sw.mjs && node scripts/generate-icons.mjs && node scripts/sync-tauri-updater-config.mjs",
    "build": "vite build",
    "icons": "node scripts/generate-icons.mjs",
    "sync:tauri-config": "node scripts/sync-tauri-updater-config.mjs",
    "preview": "vite preview --host localhost --port 5173 --strictPort",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:adhoc": "APPLE_SIGNING_IDENTITY=- tauri build",
    "cap:sync": "npx cap sync",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android",
    "db:push": "supabase db push",
    "db:push:all": "supabase db push --include-all --yes",
    "deploy:edge": "bash scripts/deploy-edge-functions.sh",
    "test:tenant-isolation": "node scripts/tenant-isolation-test.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@tauri-apps/cli": "^2.8.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.0",
    "browserslist-to-esbuild": "^2.1.1",
    "postcss": "^8.5.10",
    "sharp": "^0.34.5",
    "supabase": "^2.91.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3",
    "vite": "^6.2.0"
  },
  "sideEffects": [
    "src/legacy/**/*.js",
    "src/entries/bootstrap.js",
    "src/entries/bootstrap-app.js",
    "src/entries/auth-callback-page.js",
    "src/entries/chart-setup.js",
    "src/entries/supabase-vendor.js",
    "src/entries/telemetry-init.js"
  ],
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.0.2",
    "@capacitor/core": "^7.4.3",
    "@capacitor/ios": "^7.4.3",
    "@capacitor/preferences": "^7.0.2",
    "@capacitor/push-notifications": "^7.0.2",
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/supabase-js": "2.101.1",
    "@tiptap/extension-image": "^3.23.6",
    "@tiptap/extension-link": "^3.23.6",
    "@tiptap/extension-placeholder": "^3.23.6",
    "@tiptap/extension-underline": "^3.23.6",
    "@tiptap/pm": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "chart.js": "4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion": "^12.38.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwind-merge": "^3.5.0"
  }
}
