# Copy to `.env` for local Vite (`npm run dev` / `npm run build`).
# Anon key is public by design; never put the service role key here.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_APP_URL=https://YOUR_PRODUCTION_DOMAIN

# --- Desktop updater (Tauri) ---
# Generate once: CI=true npx tauri signer generate -w src-tauri/bizdash.key -f -p ""
# Public key is committed at src-tauri/bizdash.key.pub; keep src-tauri/bizdash.key secret.
# TAURI_SIGNING_PRIVATE_KEY_PATH=src-tauri/bizdash.key
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
# TAURI_UPDATER_PUBKEY=           (optional override; defaults to bizdash.key.pub)
# TAURI_UPDATER_BASE_URL=         (optional override for updater manifest host)
# --- Edge Functions (set in Supabase Dashboard → Edge Functions → Secrets,
#     or `supabase secrets set --project-ref YOUR_REF NAME=value`) ---
# SUPABASE_URL
# SUPABASE_ANON_KEY
# SUPABASE_SERVICE_ROLE_KEY
# STRIPE_SECRET_KEY
# STRIPE_WEBHOOK_SECRET
# APP_BASE_URL              (no trailing slash; production dashboard origin)
# DASHBOARD_ALLOWED_ORIGINS (comma-separated exact origins, e.g. https://app.example.com,http://localhost:5173)
# ASSEMBLYAI_API_KEY (meeting notes realtime transcription — server-side only, never VITE_*)
# VITE_ASSEMBLYAI_STREAMING_SPEECH_MODEL (optional; default tries u3-rt-pro then universal-streaming-english)
#   Exact name required. A common typo (SSEMBLYAI_API_KEY) is accepted as fallback in Edge code only.
#   After changing secrets, redeploy assemblyai-token, assemblyai-agent-token, assemblyai-agent-tools, and deepgram-token. Redeploy Netlify after client changes.
# STRIPE_CONNECT_DEFAULT_COUNTRY (optional, ISO 3166-1 alpha-2, default US in code)
#
# --- Plaid (server-side only; never VITE_*) ---
# PLAID_CLIENT_ID
# PLAID_SECRET
# PLAID_ENV=sandbox
# PLAID_WEBHOOK_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/plaid-webhook

# --- Tenant isolation tests (`npm run test:tenant-isolation`) ---
# Two Auth users, each owner of a different organization. Never commit real passwords.
# TENANT_TEST_USER_A_EMAIL=
# TENANT_TEST_USER_A_PASSWORD=
# TENANT_TEST_USER_B_EMAIL=
# TENANT_TEST_USER_B_PASSWORD=
# TENANT_TEST_ORG_A_ID=          (optional; resolved via my_organizations() if omitted)
# TENANT_TEST_ORG_B_ID=
# TENANT_TEST_EDGE_URL=           (optional; defaults to {SUPABASE_URL}/functions/v1)
# Also reads SUPABASE_URL / SUPABASE_ANON_KEY if set (falls back to VITE_* above).
